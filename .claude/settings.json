{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(nvidia-smi:*)",
      "Read(//home/**)",
      "Write(./src/**)",
      "Write(./tests/**)",
      "Write(./configs/**)",
      "Write(./scripts/**)",
      "Write(./results/**)",
      "Write(./docs/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(pip install:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Write(./artifacts/**)",
      "Read(./.env)"
    ]
  },
  "env": {
    "PYTHONHASHSEED": "0",
    "CUBLAS_WORKSPACE_CONFIG": ":4096:8"
  }
}
